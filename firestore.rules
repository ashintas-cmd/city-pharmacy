rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    // Admins are individual documents in /admins keyed by lower-case email.
    // Keeping the allow-list in Firestore lets the owner add staff without a
    // redeploy. get()/exists() are evaluated by the backend, not the client.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    function validPhone(value) {
      return value is string && value.matches('^[0-9 +-]{10,16}$');
    }

    function validEmail(value) {
      return value is string && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function validPincode(value) {
      return value is string && value.matches('^[0-9]{6}$');
    }

    // ---------------------------------------------------------------------
    // Public catalogue — readable by everyone, writable only by admins
    // ---------------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store details are public; any other settings document is private.
    match /settings/store {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{documentId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Admin allow-list
    // ---------------------------------------------------------------------
    match /admins/{email} {
      // A signed-in user may check whether their own email is an admin.
      allow get: if signedIn() && request.auth.token.email.lower() == email;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Customer profiles
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Orders — created by the signed-in customer, managed by admins.
    // Shape validation is enforced here. Production stores should also
    // re-price the cart in a trusted server (Cloud Functions) before saving.
    // ---------------------------------------------------------------------
    match /orders/{orderId} {
      allow get: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PLACED'
        && request.resource.data.createdAt == request.time
        && request.resource.data.orderNumber is string
        && request.resource.data.customer is map
        && request.resource.data.customer.name is string
        && validPhone(request.resource.data.customer.phone)
        && request.resource.data.address is map
        && request.resource.data.address.line1 is string
        && validPincode(request.resource.data.address.pincode)
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.mrpTotal is number
        && request.resource.data.subtotal is number
        && request.resource.data.offerDiscount is number
        && request.resource.data.deliveryFee is number
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.paymentMethod in ['COD', 'UPI_ON_DELIVERY'];

      // Customers may only cancel their own order while it is still PLACED.
      allow update: if isAdmin() || (signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'PLACED'
        && request.resource.data.status == 'CANCELLED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Patient enquiries — open to any visitor (including guests), private
    // to staff. This is the form the patient fills with contact details.
    // ---------------------------------------------------------------------
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && validPhone(request.resource.data.phone)
        && request.resource.data.type in [
          'medicine-availability',
          'home-delivery',
          'prescription-help',
          'health-advice',
          'order-support',
          'feedback',
          'other'
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000
        && request.resource.data.consent == true
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    // Prescription images / PDFs are uploaded separately from the enquiry so
    // the enquiry list stays lightweight. Public create, staff-only read.
    match /prescriptionFiles/{fileId} {
      allow create: if request.resource.data.data is string
        && request.resource.data.data.size() <= 900000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // General contact messages / newsletter signups
    // ---------------------------------------------------------------------
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && validEmail(request.resource.data.email)
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 2
        && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 3000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
